---
import { carSpotterWallImages } from '@/data/car-spotter-wall';

interface Props {
  rows?: number;
  tile?: number;
  mobileTile?: number;
  class?: string;
}

const {
  rows = 6,
  tile = 96,
  mobileTile = Math.round(tile * 0.72),
  class: className,
} = Astro.props;

// Six tiles per sequence, repeated enough times that the track still covers
// the widest container at the end of its loop. The wall is a background, not
// a strip, so it stacks rows like the app's MarqueeWall.
const gap = Math.round(tile * 0.12);
const sequenceWidth = 6 * tile + 6 * gap;
const copies = Math.max(3, Math.ceil(1280 / sequenceWidth) + 1);
const shift = `${(-100 / copies).toFixed(4)}%`;

const sequences = Array.from({ length: rows }, (_, row) => {
  const start = (row * 5) % carSpotterWallImages.length;
  return Array.from(
    { length: 6 },
    (_, index) => carSpotterWallImages[(start + index) % carSpotterWallImages.length],
  );
});

const paces = [1, 0.82, 1.12, 0.92];
const zooms = [1, 1.04, 1.09, 1.02, 1.07, 1.03];
const baseDuration = 40;
---

<div
  class:list={['cwall', className]}
  aria-hidden="true"
  data-cwall
  style={`--cwall-tile-desktop:${tile}px;--cwall-tile-mobile:${mobileTile}px;`}
>
  <div class="cwall__viewport">
    {sequences.map((sequence, row) => (
      <div
        class="cwall__row"
        style={`--cwall-duration:${(baseDuration / paces[row % paces.length]).toFixed(2)}s;--cwall-direction:${row % 2 === 0 ? 'normal' : 'reverse'}`}
      >
        <div class="cwall__track" style={`--cwall-shift:${shift}`}>
          {Array.from({ length: copies }, () => (
            <div class="cwall__seq">
              {sequence.map((src, index) => (
                <span class="cwall__tile">
                  <span
                    class="cwall__img"
                    style={`background-image:url('${src}');--cwall-zoom:${zooms[(row + index) % zooms.length]}`}
                  ></span>
                </span>
              ))}
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>
</div>

<script>
  const walls = document.querySelectorAll('[data-cwall]');
  if (walls.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          entry.target.toggleAttribute('data-cwall-paused', !entry.isIntersecting);
        }
      },
      { rootMargin: '200px 0px' },
    );
    walls.forEach((wall) => observer.observe(wall));
  }
</script>

<style>
  .cwall {
    --cwall-tile: var(--cwall-tile-desktop, 96px);
    --cwall-gap: calc(var(--cwall-tile) * 0.12);
    --cwall-radius: calc(var(--cwall-tile) * 0.09);
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .cwall__viewport {
    display: flex;
    flex-direction: column;
    gap: var(--cwall-gap);
    width: 100%;
    height: 100%;
    mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 4%, #000 96%, transparent 100%);
  }

  .cwall__row {
    flex: none;
    height: var(--cwall-tile);
    overflow: hidden;
  }

  .cwall__track {
    display: flex;
    width: max-content;
    animation: cwall-scroll var(--cwall-duration, 40s) linear infinite;
    animation-direction: var(--cwall-direction, normal);
    will-change: transform;
  }

  .cwall[data-cwall-paused] .cwall__track {
    animation-play-state: paused;
  }

  .cwall__seq {
    display: flex;
    gap: var(--cwall-gap);
    padding-right: var(--cwall-gap);
  }

  .cwall__tile {
    flex: none;
    width: var(--cwall-tile);
    height: var(--cwall-tile);
    border-radius: var(--cwall-radius);
    overflow: hidden;
    background: #141618;
  }

  .cwall__img {
    display: block;
    width: 100%;
    height: 100%;
    background-position: center;
    background-size: cover;
    transform: scale(var(--cwall-zoom, 1));
  }

  @keyframes cwall-scroll {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(var(--cwall-shift, -33.3333%), 0, 0); }
  }

  @media (max-width: 640px) {
    .cwall {
      --cwall-tile: var(--cwall-tile-mobile, 72px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cwall__track {
      animation: none;
    }
  }
</style>
