---
import WorkReveal from './WorkReveal.astro';
import './hero.css';
interface Props {
  assetBase?: string;
  portraitSrc?: string;
}
const { assetBase = '/hero-2026', portraitSrc = '/images/portrait/qadan-hero-bw-q-480.webp' } = Astro.props;
---
<section class="qh" aria-labelledby="qh-title">
  <div class="container-site qh__grid">
    <div class="qh__intro">
      <div class="qh__identity">
        <img class="qh__portrait" src={portraitSrc} width="40" height="40" alt="" decoding="async" />
        <div class="qh__person"><span class="qh__name">Moe Qadan</span><span class="qh__location">UX developer · Los Angeles</span></div>
      </div>
      <h1 id="qh-title" class="qh__title"><span class="qh__title-line">I do UX and </span><span class="qh__title-line">frontend as </span><span class="qh__title-finish">one job.</span></h1>
      <p class="qh__lead">I work on shared web platforms and build independent iOS apps, carrying design decisions through to production.</p>
      <div class="qh__actions">
        <a class="qh__primary" href="/work/" data-track="cta_click" data-track-cta="see-the-work" data-track-loc="home-hero">See the work<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" stroke="currentColor" stroke-width="1.5" /></svg></a>
        <a class="qh__secondary" href="/approach/" data-track="cta_click" data-track-cta="approach" data-track-loc="home-hero">How I work</a>
      </div>
    </div>
    <WorkReveal assetBase={assetBase} />
  </div>
</section>
