---
// Hero. Editorial two-column composition: copy on the left, one
// backgroundless portrait on the right. The magenta Q is part of the
// artwork; there is no frame, spec panel, or overlay text.
---

<section class="hero" aria-label="Introduction">
  <div class="container-site hero__inner">
    <div class="hero__main">
      <h1 class="hero__headline">
        I do UX and frontend as one job.
      </h1>

      <p class="hero__paragraph">
        Design systems, frontend craft, and AI-native product
        engineering. Senior generalist working across long-running
        platforms and independent product surfaces.
      </p>

      <div class="hero__ctas">
        <a
          href="/work"
          class="hero__cta hero__cta--primary"
          data-track="cta_click"
          data-track-cta="see-the-work"
          data-track-loc="home-hero"
        >
          See the work
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
        <a
          href="/approach"
          class="hero__cta hero__cta--ghost"
          data-track="cta_click"
          data-track-cta="approach"
          data-track-loc="home-hero"
        >How I work</a>
      </div>
    </div>

    {/* Portrait. One backgroundless asset; no frame, spec panel, or overlays. */}
    <aside class="hero__portrait">
      <img
        src="/images/portrait/qadan-hero-bw-q-800.webp"
        srcset="/images/portrait/qadan-hero-bw-q-480.webp 480w, /images/portrait/qadan-hero-bw-q-800.webp 800w"
        sizes="(min-width: 1024px) 400px, (min-width: 600px) 420px, 90vw"
        alt="Moe Qadan"
        width="1122"
        height="1402"
        fetchpriority="high"
        decoding="async"
        class="hero__portrait-img"
      />
    </aside>
  </div>

</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(60px + var(--space-10));
    padding-bottom: var(--space-12);
  }

  @media (min-width: 600px) {
    .hero {
      padding-top: calc(64px + var(--space-12));
      padding-bottom: var(--space-20);
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding-top: calc(64px + var(--space-16));
      padding-bottom: var(--space-24);
    }
  }

  @media (min-width: 1024px) {
    .hero {
      padding-top: calc(64px + 96px);
      padding-bottom: 128px;
    }
  }

  .hero__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    align-items: start;
  }

  .hero__main { order: 1; max-width: 760px; }
  .hero__portrait { order: 2; }

  @media (min-width: 640px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.35fr) minmax(220px, 300px);
      gap: clamp(var(--space-6), 4vw, var(--space-12));
      align-items: end;
    }
  }

  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.4fr) minmax(300px, 380px);
      gap: var(--space-16);
    }
  }

  @media (min-width: 1200px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.55fr) 400px;
      gap: 96px;
    }
  }

  .hero__headline {
    font-family: var(--font-display);
    font-size: clamp(40px, 8.2vw, 96px);
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.04;
    color: var(--color-text);
    margin-bottom: var(--space-6);
    max-width: 18ch;
    text-wrap: balance;
  }

  @media (min-width: 640px) and (max-width: 1023px) {
    .hero__headline {
      font-size: clamp(40px, 6vw, 64px);
    }
  }

  @media (min-width: 768px) {
    .hero__headline {
      line-height: 1.02;
      letter-spacing: -0.02em;
      margin-bottom: var(--space-8);
    }
  }


  .hero__paragraph {
    font-size: clamp(15px, 1.5vw, 18px);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 60ch;
    margin-bottom: var(--space-5);
  }

  .hero__paragraph--meta {
    color: var(--color-text-subtle);
    font-size: clamp(14px, 1.4vw, 16px);
    margin-bottom: 0;
  }

  .hero__inline-link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border-strong);
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
    transition: color 150ms, text-decoration-color 150ms;
  }

  .hero__inline-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 12px;
    margin-top: var(--space-8);
  }

  @media (min-width: 768px) {
    .hero__ctas {
      margin-top: var(--space-10);
      gap: 12px 16px;
    }
  }

  .hero__cta {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: 9999px;
    font-size: 15px;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    transition:
      transform 200ms var(--ease-out),
      background-color 200ms,
      border-color 200ms,
      color 200ms,
      box-shadow 280ms;
    -webkit-tap-highlight-color: transparent;
    overflow: hidden;
  }

  .hero__cta--primary {
    background-color: var(--color-text);
    color: var(--color-bg);
    border: 1px solid var(--color-text);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.5) inset,
      0 1px 2px rgba(0,0,0,0.2),
      0 6px 20px rgba(0,0,0,0.18);
  }

  :global([data-theme="dark"]) .hero__cta--primary {
    box-shadow:
      0 1px 0 rgba(255,255,255,0.6) inset,
      0 1px 2px rgba(0,0,0,0.4),
      0 8px 24px rgba(0,0,0,0.35);
  }

  .hero__cta--primary:hover {
    transform: translateY(-1px);
    box-shadow:
      0 1px 0 rgba(255,255,255,0.5) inset,
      0 12px 28px rgba(0,0,0,0.18),
      0 0 0 4px var(--color-accent-dim);
  }

  .hero__cta--primary svg {
    transition: transform 220ms var(--ease-out);
  }

  .hero__cta--primary:hover svg {
    transform: translateX(2px);
  }

  .hero__cta--ghost {
    background-color: transparent;
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }

  .hero__cta--ghost:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-accent-dim);
  }

  @media (max-width: 380px) {
    .hero__ctas {
      flex-direction: column;
      align-items: stretch;
    }
    .hero__cta {
      width: 100%;
    }
  }

  /* ─── Portrait ─────────────────────────────────────────────────────
     One backgroundless asset. No frame, border, shadow, spec panel, or
     overlaid Q; the magenta Q is part of the artwork. */

  .hero__portrait {
    --portrait-max: 380px;
    width: 100%;
    max-width: var(--portrait-max);
    margin-inline: auto;
  }

  @media (min-width: 600px) {
    .hero__portrait {
      --portrait-max: 420px;
    }
  }

  @media (min-width: 1024px) {
    .hero__portrait {
      --portrait-max: 100%;
      margin-inline: 0;
    }
  }

  .hero__portrait-img {
    display: block;
    width: 100%;
    height: auto;
  }
  @media (max-width: 420px) {
    .hero { padding-top: calc(60px + var(--space-6)); }
    .hero__headline {
      font-size: clamp(36px, 9vw, 44px);
      margin-bottom: var(--space-4);
    }
    .hero__paragraph {
      font-size: 14px;
      line-height: 1.55;
      margin-bottom: var(--space-3);
    }
    .hero__ctas { margin-top: var(--space-5); }
  }

  @media (min-width: 900px) and (max-height: 700px) {
    .hero__inner { align-items: start; }
    .hero__headline {
      font-size: clamp(44px, 5.2vw, 56px);
      margin-bottom: var(--space-5);
    }
    .hero__paragraph { margin-bottom: var(--space-3); }
    .hero__ctas { margin-top: var(--space-6); }
    .hero__portrait { max-width: 280px; }
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .hero {
      padding-top: calc(52px + var(--safe-top) + var(--space-4));
      padding-bottom: var(--space-8);
    }
    .hero__inner {
      grid-template-columns: minmax(0, 1fr) 150px;
      gap: var(--space-5);
      align-items: center;
    }
    .hero__headline {
      font-size: clamp(32px, 5.4vw, 44px);
      line-height: 1.03;
      margin-bottom: var(--space-3);
      max-width: 16ch;
    }
    .hero__paragraph {
      font-size: 13px;
      line-height: 1.35;
      margin-bottom: var(--space-2);
      max-width: 52ch;
    }
    .hero__ctas {
      margin-top: var(--space-3);
      gap: 8px;
    }
    .hero__cta { min-height: 44px; padding: 0 16px; }
    .hero__portrait { max-width: 150px; }
  }
</style>
