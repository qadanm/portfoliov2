---
import PortfolioLogo from '@/components/brand/PortfolioLogo.astro';

const pathname = Astro.url.pathname;

const nav = [
  { href: '/work/', label: 'Work', sub: 'Selected projects and case studies.' },
  { href: '/approach/', label: 'Approach', sub: 'How I work.' },
  { href: '/about/', label: 'About', sub: 'Background and experience.' },
  { href: '/contact/', label: 'Contact', sub: 'Send a message.' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}
---

<header class="site-header" id="site-header" transition:persist>
  <div class="container-site header-inner">
    <div class="header-logo header-logo--full">
      <PortfolioLogo />
    </div>
    <div class="header-logo header-logo--compact">
      <PortfolioLogo variant="compact" />
    </div>

    <nav class="nav-desktop" aria-label="Primary navigation">
      {nav.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <a
        href="/contact/"
        class="status-pill"
        aria-label="Send a message"
        title="Send a message"
      >
        <span class="status-pill__dot" aria-hidden="true"></span>
        <span class="status-pill__text">Send a message</span>
      </a>

      <button
        type="button"
        class="theme-toggle"
        id="theme-toggle"
        aria-label="Toggle color theme"
        title="Toggle theme"
      >
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M18.66 5.34l-1.41 1.41"/>
        </svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <button
        type="button"
        class="nav-mobile-toggle"
        id="mobile-menu-toggle"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <noscript is:raw>
    <style>
      .site-header { position: static !important; }
      .nav-mobile-toggle, .theme-toggle { display: none !important; }
      .nav-noscript {
        display: flex;
        align-items: center;
        gap: 2px;
        padding: 2px 12px 8px;
        overflow-x: auto;
        border-bottom: 1px solid var(--color-border-subtle);
        background: var(--color-bg);
      }
      .nav-noscript a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        padding: 0 10px;
        font-family: var(--font-body);
        font-size: 14px;
        font-weight: 500;
        color: var(--color-text-muted);
        text-decoration: none;
        white-space: nowrap;
      }
      .nav-noscript a:hover { color: var(--color-text); }
      @media (min-width: 640px) { .nav-noscript { display: none !important; } }
</style>
    <nav class="nav-noscript" aria-label="Primary navigation">
      <a href="/work">Work</a>
      <a href="/approach">Approach</a>
      <a href="/about">About</a>
      <a href="/contact">Contact</a>
    </nav>
  </noscript>

  <!-- Mobile Nav -->
  <div class="nav-mobile-backdrop" id="mobile-nav-backdrop" aria-hidden="true"></div>
  <div class="nav-mobile" id="mobile-nav" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Site navigation" inert>
    <nav class="nav-mobile__inner" aria-label="Mobile navigation">
      <span class="nav-mobile__eyebrow">
        <span class="nav-mobile__status">
          <span class="status-pill__dot" aria-hidden="true"></span>
          moe@qadan.co
        </span>
      </span>
      <ul class="nav-mobile__list">
        {nav.map((item, i) => (
          <li>
            <a
              href={item.href}
              class:list={['nav-mobile-link', { 'nav-mobile-link--active': isActive(item.href) }]}
              aria-current={isActive(item.href) ? 'page' : undefined}
              style={`--i: ${i}`}
            >
              <span class="nav-mobile-link__body">
                <span class="nav-mobile-link__label">{item.label}</span>
                <span class="nav-mobile-link__sub">{item.sub}</span>
              </span>
              <span class="nav-mobile-link__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="nav-mobile__foot">
        <a
          href="mailto:moe@qadan.co"
          class="nav-mobile__email"
          data-track="contact_click"
          data-track-channel="email"
          data-track-loc="mobile-nav"
        >moe@qadan.co</a>
        <span class="nav-mobile__sig">© Moe Qadan</span>
      </div>
    </nav>
  </div>
</header>

<script>
  import { THEME_KEY } from '@/utils/theme';

  const headerWindow = window as Window & { __qadanHeaderBound?: boolean };

  function headerEl() {
    return document.getElementById('site-header');
  }

  function menuEls() {
    return {
      toggle: document.getElementById('mobile-menu-toggle'),
      nav: document.getElementById('mobile-nav'),
      backdrop: document.getElementById('mobile-nav-backdrop'),
    };
  }

  function getTheme() {
    const attr = document.documentElement.getAttribute('data-theme');
    if (attr === 'dark' || attr === 'light') return attr;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function syncThemeButton() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    const dark = getTheme() === 'dark';
    const label = dark ? 'Switch to light theme' : 'Switch to dark theme';
    toggle.setAttribute('aria-label', label);
    toggle.setAttribute('title', label);
    toggle.setAttribute('aria-pressed', dark ? 'true' : 'false');
  }

  function setTheme(theme: string) {
    document.documentElement.setAttribute('data-theme', theme);
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // The attribute still changes if storage is unavailable.
    }
    syncThemeButton();
  }

  function toggleTheme() {
    const from = getTheme();
    const to = from === 'dark' ? 'light' : 'dark';
    setTheme(to);
    if (typeof window.plausible === 'function') {
      window.plausible('theme_toggle', { props: { from, to } });
    }
  }

  function isMenuOpen() {
    return menuEls().toggle?.getAttribute('aria-expanded') === 'true';
  }

  function lockScroll() {
    const scrollY = window.scrollY;
    document.body.dataset.scrollLock = String(scrollY);
    document.body.style.position = 'fixed';
    document.body.style.top = `-${scrollY}px`;
    document.body.style.left = '0';
    document.body.style.right = '0';
    document.body.style.width = '100%';
  }

  function unlockScroll() {
    const scrollY = parseInt(document.body.dataset.scrollLock || '0', 10);
    document.body.style.position = '';
    document.body.style.top = '';
    document.body.style.left = '';
    document.body.style.right = '';
    document.body.style.width = '';
    delete document.body.dataset.scrollLock;
    if (scrollY) window.scrollTo(0, scrollY);
  }

  function openMenu() {
    const { toggle, nav, backdrop } = menuEls();
    if (!toggle || !nav) return;
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Close menu');
    nav.setAttribute('aria-hidden', 'false');
    nav.removeAttribute('inert');
    backdrop?.setAttribute('aria-hidden', 'false');
    nav.classList.add('nav-mobile--open');
    backdrop?.classList.add('nav-mobile-backdrop--open');
    toggle.classList.add('is-open');
    lockScroll();
    requestAnimationFrame(() => {
      nav.querySelector<HTMLAnchorElement>('.nav-mobile-link')?.focus();
    });
    if (typeof window.plausible === 'function') {
      window.plausible('nav_open', { props: { page: location.pathname } });
    }
  }

  function closeMenu(returnFocus = false) {
    const { toggle, nav, backdrop } = menuEls();
    if (!toggle || toggle.getAttribute('aria-expanded') !== 'true') return;
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Open menu');
    nav?.setAttribute('aria-hidden', 'true');
    nav?.setAttribute('inert', '');
    backdrop?.setAttribute('aria-hidden', 'true');
    nav?.classList.remove('nav-mobile--open');
    backdrop?.classList.remove('nav-mobile-backdrop--open');
    toggle.classList.remove('is-open');
    unlockScroll();
    if (returnFocus) toggle.focus();
  }

  function syncActiveNav() {
    const path = window.location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('.nav-link, .nav-mobile-link').forEach(link => {
      const href = link.getAttribute('href') || '';
      const active = href === '/' ? path === '/' : path.startsWith(href);
      link.classList.toggle('nav-link--active', active && link.classList.contains('nav-link'));
      link.classList.toggle('nav-mobile-link--active', active && link.classList.contains('nav-mobile-link'));
      if (active) {
        link.setAttribute('aria-current', 'page');
      } else {
        link.removeAttribute('aria-current');
      }
    });
  }

  function updateHeaderState() {
    const header = headerEl();
    if (!header) return;
    header.classList.toggle('header--scrolled', window.scrollY > 32);
  }

  function initHeader() {
    syncThemeButton();
    syncActiveNav();
    updateHeaderState();
    if (isMenuOpen()) closeMenu();
  }

  if (!headerWindow.__qadanHeaderBound) {
    headerWindow.__qadanHeaderBound = true;

    // Delegation survives the header being replaced by Astro view transitions.
    document.addEventListener('click', (event) => {
      const target = event.target instanceof Element ? event.target : null;
      if (!target) return;
      if (target.closest('#theme-toggle')) {
        event.preventDefault();
        toggleTheme();
        return;
      }
      if (target.closest('#mobile-menu-toggle')) {
        event.preventDefault();
        if (isMenuOpen()) closeMenu(); else openMenu();
        return;
      }
      if (target.closest('#mobile-nav-backdrop')) {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (target.closest('#mobile-nav a')) {
        closeMenu();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isMenuOpen()) {
        closeMenu(true);
        return;
      }
      if (event.key === 'Tab' && isMenuOpen()) {
        const nav = menuEls().nav;
        if (!nav) return;
        const focusables = [...nav.querySelectorAll<HTMLElement>('a[href]')]
          .filter(el => el.getClientRects().length > 0);
        if (focusables.length === 0) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      }
    });

    const desktopMQ = window.matchMedia('(min-width: 768px)');
    const onMQChange = (event: MediaQueryListEvent | MediaQueryList) => {
      if (event.matches && isMenuOpen()) closeMenu();
    };
    if (typeof desktopMQ.addEventListener === 'function') {
      desktopMQ.addEventListener('change', onMQChange);
    } else {
      desktopMQ.addListener(onMQChange);
    }

    document.addEventListener('astro:before-swap', () => closeMenu());
    document.addEventListener('astro:after-swap', initHeader);
    document.addEventListener('astro:page-load', initHeader);
    window.addEventListener('scroll', updateHeaderState, { passive: true });

    new MutationObserver(syncThemeButton).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
  }

  initHeader();
</script>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding-top: var(--safe-top);
    padding-left: var(--safe-left);
    padding-right: var(--safe-right);
    border-bottom: 1px solid transparent;
    transition: background-color 280ms ease, border-color 280ms ease, backdrop-filter 280ms ease, box-shadow 280ms ease;
  }

  .header--scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 96%, transparent);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    border-bottom-color: var(--color-border);
    box-shadow:
      0 8px 30px -20px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.03);
  }

  .header--scrolled .nav-link {
    color: var(--color-text);
  }

  .header--scrolled .nav-link:hover {
    color: var(--color-accent);
  }

  @supports not (backdrop-filter: blur(1px)) {
    .header--scrolled {
      background-color: var(--color-bg);
    }
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 60px;
    gap: 12px;
  }

  @media (min-width: 768px) {
    .header-inner {
      height: 64px;
      gap: 24px;
    }
  }

  @media (orientation: landscape) and (max-height: 500px) {
    .header-inner { height: 52px; }
  }

  .header-logo {
    display: flex;
    align-items: center;
    flex: 0 0 auto;
  }

  .header-logo--compact {
    display: none;
  }

  @media (max-width: 767px) {
    .header-logo--full {
      display: none;
    }

    .header-logo--compact {
      display: flex;
    }
  }

  .nav-noscript {
    display: flex;
    align-items: center;
    gap: 2px;
    padding: 2px 12px 8px;
    overflow-x: auto;
    border-bottom: 1px solid var(--color-border-subtle);
    background: var(--color-bg);
  }

  .nav-noscript a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 10px;
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav-noscript a:hover { color: var(--color-text); }

  .nav-desktop {
    display: none;
    align-items: center;
    gap: 2px;
    flex: 1;
    justify-content: center;
  }

  @media (min-width: 640px) {
    .nav-desktop { display: flex; }
  }

  .nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 8px 14px;
    border-radius: 9999px;
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 180ms;
    letter-spacing: -0.01em;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 4px;
    height: 1px;
    background-color: var(--color-accent);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 240ms var(--ease-out);
  }

  .nav-link:hover {
    color: var(--color-text);
  }

  .nav-link:hover::after {
    transform: scaleX(0.6);
  }

  .nav-link--active {
    color: var(--color-text);
  }

  .nav-link--active::after {
    transform: scaleX(1);
    background-color: var(--color-accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  /* Header contact pill — neutral entry point to the contact page */
  .status-pill {
    display: none;
    align-items: center;
    gap: 7px;
    min-height: 44px;
    padding: 8px 12px 8px 11px;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color 150ms, border-color 150ms, color 150ms, transform 150ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  @media (min-width: 600px) {
    .status-pill { display: inline-flex; }
  }

  .status-pill:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-dim);
    transform: translateY(-1px);
  }

  .status-pill__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-text-subtle);
    flex-shrink: 0;
    transition: background-color 150ms;
  }

  .status-pill:hover .status-pill__dot {
    background-color: var(--color-accent);
  }

  .theme-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 9999px;
    border: 1px solid var(--color-border);
    background: linear-gradient(180deg, var(--color-bg-elevated), var(--color-bg-muted));
    color: var(--color-text-muted);
    cursor: pointer;
    transition: all 180ms var(--ease-out);
    flex-shrink: 0;
    -webkit-tap-highlight-color: transparent;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.04);
  }

  .theme-toggle:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-dim);
    transform: rotate(15deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .theme-toggle:hover { transform: none; }
  }

  .icon-moon { display: none; }

  :global([data-theme="dark"]) .icon-sun { display: none; }
  :global([data-theme="dark"]) .icon-moon { display: block; }

  .nav-mobile-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    background: transparent;
    cursor: pointer;
    transition: all 150ms;
    -webkit-tap-highlight-color: transparent;
    position: relative;
    z-index: 102;
  }

  @media (min-width: 640px) {
    .nav-mobile-toggle { display: none; }
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 18px;
    height: 1.5px;
    background-color: var(--color-text);
    border-radius: 9999px;
    transition: all 220ms var(--ease-out);
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
  }

  .hamburger::before { top: -6px; }
  .hamburger::after { top: 6px; }

  .is-open .hamburger { background-color: transparent; }
  .is-open .hamburger::before { transform: rotate(45deg); top: 0; }
  .is-open .hamburger::after { transform: rotate(-45deg); top: 0; }

  .nav-mobile-backdrop {
    position: fixed;
    inset: 0;
    background-color: color-mix(in srgb, var(--color-bg) 70%, transparent);
    backdrop-filter: blur(8px) saturate(120%);
    -webkit-backdrop-filter: blur(8px) saturate(120%);
    opacity: 0;
    pointer-events: none;
    transition: opacity 240ms var(--ease-out);
    z-index: 99;
  }

  .nav-mobile-backdrop--open {
    opacity: 1;
    pointer-events: auto;
  }

  @media (min-width: 640px) {
    .nav-mobile-backdrop { display: none !important; }
  }

  .nav-mobile {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 100vh;
    height: 100dvh;
    background-color: var(--color-bg);
    z-index: 101;
    transform: translateY(-100%);
    transition: transform 360ms var(--ease-out);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-top: calc(60px + var(--safe-top));
    padding-bottom: var(--safe-bottom);
    padding-left: var(--safe-left);
    padding-right: var(--safe-right);
    -webkit-overflow-scrolling: touch;
  }

  .nav-mobile--open {
    transform: translateY(0);
  }

  @media (min-width: 640px) {
    .nav-mobile { display: none !important; }
  }

  .nav-mobile__inner {
    display: flex;
    flex-direction: column;
    min-height: calc(100dvh - 60px - var(--safe-top) - var(--safe-bottom));
    padding: 24px 24px calc(32px + var(--safe-bottom));
  }

  .nav-mobile__eyebrow {
    display: flex;
    align-items: center;
    margin-bottom: 12px;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--color-border-subtle);
    opacity: 0;
    transform: translateY(-4px);
    transition: opacity 280ms var(--ease-out) 80ms, transform 280ms var(--ease-out) 80ms;
  }

  .nav-mobile--open .nav-mobile__eyebrow {
    opacity: 1;
    transform: none;
  }

  .nav-mobile__status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .nav-mobile__status .status-pill__dot {
    background-color: var(--color-text-subtle);
    box-shadow: none;
  }

  .nav-mobile__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .nav-mobile__list li {
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .nav-mobile__list li:last-child {
    border-bottom: none;
  }

  .nav-mobile-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 16px;
    padding: 18px 4px;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--duration-base) var(--ease-out), padding-left var(--duration-base) var(--ease-out);
    opacity: 0;
    transform: translateY(12px);
    -webkit-tap-highlight-color: transparent;
    min-height: 64px;
  }

  .nav-mobile--open .nav-mobile-link {
    animation: navLinkRise 420ms var(--ease-out) forwards;
    animation-delay: calc(120ms + var(--i, 0) * 60ms);
  }

  @keyframes navLinkRise {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }


  .nav-mobile-link__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .nav-mobile-link__label {
    font-family: var(--font-display);
    font-size: 26px;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.05;
    color: var(--color-text);
  }

  .nav-mobile-link__sub {
    font-size: 13px;
    line-height: 1.4;
    color: var(--color-text-subtle);
