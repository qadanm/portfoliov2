---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Hero from '@/components/home-hero/Hero.astro';
import GarageShowcase from '@/components/home/GarageShowcase.astro';
import ExperienceWall from '@/components/home/ExperienceWall.astro';
import MethodSequence from '@/components/ui/MethodSequence.astro';
import ContactBand from '@/components/ui/ContactBand.astro';

---

<BaseLayout
  title="Moe Qadan, UX Engineer & Frontend Systems"
  description="Portfolio of Moe Qadan, a senior UX and frontend practitioner in Los Angeles. UX engineering, frontend systems, design systems, content architecture, SEO, accessibility, and AI-assisted product work. Selected projects include CarSpotter, a daily car-identification game for iPhone; VINly, free VIN research for used-car shoppers; ChatOBD2, in QA and field testing; MagTek's eleven-site full-stack platform; and advisor portals deployed across more than 50 wealth and banking institutions."
  keywords={[
    'Moe Qadan',
    'Muhammed Qadan',
    'UX engineer',
    'frontend engineer',
    'design engineer',
    'web experience',
    'design systems',
    'creative technologist',
    'AI-assisted product design',
    'Los Angeles UX engineer',
    'portfolio',
  ]}
  image="/brand-system/open_graph/home_light.png"
  imageAlt="UX and frontend, as one job. / Moe Qadan"
>
  <Hero />

  {/* The Garage — three apps in the main sequence, two libraries on a shelf. */}
  <GarageShowcase />

  {/* Experience — the long-running platforms, with scale and contribution separated. */}
  <ExperienceWall />

  {/* Method — numbered editorial sequence, one artifact per step. */}
  <section class="home-method" id="approach-teaser">
    <div class="container-site">
      <div class="home-method__head">
        <div class="q-sxn">
          <span class="q-cut" aria-hidden="true"></span>
          <span class="q-eyebrow">How I work</span>
        </div>
        <p class="home-method__lead">
          A lot of the work I take on looks like repair. A platform that
          grew without a system. A site that ranks well and converts badly.
          A frontend that ships fine on Chrome and falls apart on iOS.
          Existing AI tooling that needs a real home in the codebase.
        </p>
        <a class="home-method__more" href="/approach" data-track="cta_click" data-track-cta="more-approach" data-track-loc="home-approach">
          Read the long version
          <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <MethodSequence class="home-method__list" headingLevel="h2" />
    </div>
  </section>

  <ContactBand title="Tell me what you're working on.">
    <a href="/contact" data-track="cta_click" data-track-cta="contact-page" data-track-loc="home-contact">Send a message</a>
    <a href="https://linkedin.com/in/mqadan" target="_blank" rel="noopener noreferrer" data-track="contact_click" data-track-channel="linkedin" data-track-loc="home-contact">LinkedIn</a>
    <a href="https://github.com/qadanm" target="_blank" rel="noopener noreferrer" data-track="contact_click" data-track-channel="github" data-track-loc="home-contact">GitHub</a>
  </ContactBand>
</BaseLayout>

<style>
  .home-method {
    padding-top: var(--space-16);
    padding-bottom: var(--space-16);
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 768px) {
    .home-method {
      padding-top: var(--space-24);
      padding-bottom: var(--space-24);
    }
  }

  .home-method__head {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
    max-width: 820px;
    margin-bottom: var(--space-10);
  }

  @media (min-width: 900px) {
    .home-method__head {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: var(--space-10);
    }
    .home-method__head .q-sxn,
    .home-method__lead {
      grid-column: 1;
    }
    .home-method__more {
      grid-column: 2;
      grid-row: 2;
      justify-self: end;
    }
  }

  .home-method__lead {
    font-family: var(--font-display);
    font-size: clamp(22px, 2.6vw, 30px);
    font-weight: 400;
    letter-spacing: -0.018em;
    line-height: 1.35;
    color: var(--color-text);
    max-width: 34ch;
  }

  .home-method__more {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    gap: 8px;
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
    width: fit-content;
  }

  .home-method__more:hover { color: var(--color-accent); }
</style>
