<style>
  /* ─── The project's own colour ────────────────────────────────────────
     Keyed on the SLUG, not the category — category is a filing label, it
     was never a design fact. Every value below is lifted from the artifact
     component for that project (src/components/artifacts/), which was drawn
     against the shipped product. Nothing here is invented, and nothing is
     sampled: --plane is the product's colour and --ink is the pairing the
     product itself uses (CarSpotter sets black on lime on its own button;
     VINly's ink is its own placeholder.from).

     It is spent as a PLANE and nowhere else. A plane carries its own field,
     so it reads identically in both themes and needs no light/dark fork —
     which is exactly what an accent used as text could not do: #C8FF00 is
     16.9:1 on the dark page and 1.13:1 on the light one. */
  .cs {
    --plane: var(--color-accent);
    --ink: #1F1408;
    position: relative;
  }

  .cs--car-spotter         { --plane: #C8FF00; --ink: #0B0C0E; }  /* CarSpotterArtifact */
  .cs--vinly               { --plane: #EA580C; --ink: #1A120B; }  /* VinlyArtifact */
  .cs--chatobd2            { --plane: #F59E0B; --ink: #1F1408; }  /* VerdictArtifact — check-engine amber */
  .cs--elmulator           { --plane: #0969DA; --ink: #FFFFFF; }  /* ElmulatorArtifact — GitHub blue; it ships on the Marketplace */
  .cs--vinplain            { --plane: #D7261E; --ink: #FFFFFF; }  /* vinplain — the public-record red */
  .cs--magtek-platform     { --plane: #1E40AF; --ink: #FFFFFF; }  /* PlatformArtifact */
  .cs--financial-platforms { --plane: #0E1A33; --ink: #FFFFFF; }  /* AdvisorArtifact */

  /* Page-level accent atmosphere — sits behind the header. */
  .cs__header {
    position: relative;
    padding-top: calc(60px + var(--space-8));
    padding-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .cs__header {
      padding-top: calc(64px + var(--space-12));
      padding-bottom: var(--space-10);
    }
  }

  .cs__back {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-muted);
    text-decoration: none;
    margin-bottom: var(--space-6);
    padding: 6px 0;
    transition: color 150ms, transform 200ms var(--ease-out);
    -webkit-tap-highlight-color: transparent;
  }

  .cs__back:hover {
    color: var(--color-accent);
    transform: translateX(-2px);
  }

  /* Numbered case-study head */
  .cs__sxn {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: var(--space-6);
    flex-wrap: wrap;
  }

  .cs__sxn-num {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 22px;
    padding: 0 8px;
    border-radius: 4px;
    border: 1px solid var(--color-border);
    background-color: var(--color-bg-elevated);
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
  }

  .cs__sxn-tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text-muted);
    padding: 4px 10px;
    border-radius: 9999px;
    background-color: var(--color-bg-deep);
    border: 1px solid var(--color-border);
    line-height: 1;
  }


  .cs__sxn-tag--flagship {
    /* --color-accent is 3.05:1 on the light page — fine as a fill, not as 10px
       text. The hover shade is the same hue at 4.83:1 and is already in the
       token set, so no new colour enters the system. */
    color: var(--color-accent-hover);
    background-color: var(--color-accent-dim);
    border-color: var(--color-accent-muted);
  }

  .cs__sxn-company {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    color: var(--color-text-subtle);
    padding: 4px 10px;
    border-radius: 9999px;
    border: 1px dashed var(--color-border);
    line-height: 1;
  }

  .cs__sxn-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), transparent);
    min-width: 40px;
  }

  .cs__sxn-meta {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-text-muted);
  }

  .cs__title {
    font-family: var(--font-display);
    font-size: clamp(38px, 9vw, 88px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: var(--space-4);
    max-width: 16ch;
  }

  /* Accent rule under the headline — picks up the project color */

  @media (min-width: 768px) {
    .cs__title {
      line-height: 1.02;
      margin-bottom: var(--space-5);
    }
  }

  /* Dek and the optional summary are one block. The gap lives here so neither
     paragraph carries a negative margin to cancel the other's. */
  .cs__lede {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-bottom: var(--space-8);
  }

  @media (min-width: 768px) {
    .cs__lede {
      gap: var(--space-5);
      margin-bottom: var(--space-10);
    }
  }

  .cs__short {
    font-size: clamp(16px, 1.8vw, 21px);
    line-height: 1.55;
    color: var(--color-text-muted);
    max-width: 56ch;
  }

  /* Long-form hero summary — optional, and only rendered when the project
     record carries one. Sits under the dek, above the facts. */
  .cs__summary {
    font-size: clamp(15px, 1.4vw, 17px);
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 66ch;
  }

  .cs__meta {
    margin: 0;
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    /* Wrapped fact rows need a tighter row rhythm than the column rhythm:
       48px between two facts on one row is air, 48px between stacked rows
       is a gap that reads as missing content. */
    row-gap: var(--space-4);
    column-gap: var(--space-6);
  }

  @media (min-width: 768px) {
    .cs__meta {
      row-gap: var(--space-6);
      column-gap: var(--space-12);
      padding-top: var(--space-8);
    }
  }

  .cs__meta div {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cs__meta dt {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    /* Was --color-text-subtle: 2.45:1 on the light page, 4.14:1 on the dark
       one. These are the labels for Role / Period / Scope — informational
       text, not decoration, so they have to clear 4.5:1. */
    color: var(--color-text-muted);
  }

  .cs__meta dd { margin: 0; }

  .cs__meta ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 6px 14px;
  }

  .cs__meta li {
    font-size: 14px;
    color: var(--color-text);
    font-weight: 500;
    line-height: 1.4;
  }

  .cs__meta li + li::before {
    /* No separator glyph: the list already has a 14px column gap, and a
       ::before lives inside the <li>, so when an item wrapped the dot and its
       margin started the new line and indented the label. */
    content: none;
  }

  .cs__meta-text {
    font-size: 14px;
    color: var(--color-text);
    font-weight: 500;
    line-height: 1.4;
  }

  .cs__meta-text--status {
    /* --color-success (#059669) is 3.60:1 on the light page — fine for the dot,
       not for 12px text. #047857 is the same green at 5.20:1. */
    color: #047857;
    font-family: var(--font-body);
    font-size: 12px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  :global([data-theme="dark"]) .cs__meta-text--status {
    color: #34D399;
  }

  .cs__status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-success);
    box-shadow: 0 0 6px color-mix(in srgb, var(--color-success) 65%, transparent);
    animation: cs-status-pulse 2.4s ease-in-out infinite;
  }

  @keyframes cs-status-pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.85); }
  }

  /* Coming-soon status — muted, not the live green, and no pulse. */
  .cs__meta-text--coming {
    color: var(--color-text-muted);
  }

  .cs__status-dot--coming {
    background-color: var(--color-text-subtle);
    box-shadow: none;
    animation: none;
  }

  /* ── Live-product links: header badge row + closing download band ──── */
  .cs__get {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
    margin-top: var(--space-6);
  }
  .cs__get-site {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    /* 24px minimum tap height — the label is 12px, so the padding carries it. */
    min-height: 24px;
    padding-block: 4px;
    font-family: var(--font-body);
    font-size: 12px;
    color: var(--color-text-muted);
    transition: color 200ms var(--ease-out);
  }
  .cs__get-site:hover { color: var(--color-text); }
  .cs__get-site svg { transition: transform 200ms var(--ease-out); }
  .cs__get-site:hover svg { transform: translate(2px, -2px); }

  .cs__download {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    flex-wrap: wrap;
    margin-top: var(--space-12);
    padding: var(--space-7) var(--space-7);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: linear-gradient(180deg, var(--color-bg-elevated), var(--color-bg-muted));
  }
  .cs__download-title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3vw, 28px);
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 6px;
  }
  .cs__download-sub {
    font-size: 14px;
    color: var(--color-text-muted);
  }
  .cs__download-actions {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-wrap: wrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .cs__status-dot { animation: none; }
  }

  /* Outcomes panel */
  .cs__outcomes-wrap {
    padding-top: var(--space-6);
    padding-bottom: var(--space-2);
  }

  @media (min-width: 768px) {
    .cs__outcomes-wrap {
      padding-top: var(--space-8);
    }
  }

  /* The one place the project's colour is spent, and it is spent as a field.
     These are the measurements the work actually produced — they were being
     served as the same elevated stats card every SaaS site ships. The card
     is gone: no border, no radius, no shadow, no gradient, no glow. */
  .cs__outcomes {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6);
    background: var(--plane);
    color: var(--ink);
    position: relative;
  }

  @media (min-width: 720px) {
    .cs__outcomes {
      padding: var(--space-8);
    }
  }

  .cs__outcomes-head {
    display: flex;
    align-items: center;
    gap: 12px;
    position: relative;
    z-index: 1;
  }


  .cs__outcomes-eyebrow {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--ink);
  }

  .cs__outcomes-rule {
    flex: 1;
    height: 1px;
    background: currentColor;
    opacity: 0.25;
  }

  .cs__outcomes-meta {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--ink);
  }

  .cs__outcomes-list {
