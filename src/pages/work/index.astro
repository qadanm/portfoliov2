---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ProjectIndexRow from '@/components/ui/ProjectIndexRow.astro';

// Same ordering as the case-study template, so the index position a visitor
// reads here is the same "04 / 06" the case study shows.
const allProjects = (await getCollection('build', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const numberOf = (slug: string) =>
  String(allProjects.findIndex(p => p.slug === slug) + 1).padStart(2, '0');

const thumbnail = (slug: string) => `/images/work-thumbs/${slug}.webp`;
---

<BaseLayout
  title="Selected Work"
  description="Selected case studies by Moe Qadan. CarSpotter, a daily car-identification game for iPhone; VINly, free VIN research for used-car buyers; vinplain, an open-source TypeScript client for US vehicle records; ChatOBD2, an AI car-diagnostics app in QA; MagTek's eleven-site full-stack platform; and advisor portals for more than 50 wealth and banking institutions at InvestCloud."
  keywords={[
    'Moe Qadan',
    'portfolio',
    'UX engineering portfolio',
    'frontend portfolio',
    'design systems portfolio',
    'case studies',
    'CarSpotter',
    'VINly',
    'vinplain',
    'ChatOBD2',
    'MagTek',
    'InvestCloud',
  ]}
  image="/brand-system/open_graph/work_light.png"
  imageAlt="Selected work. / Moe Qadan"
>
  <div class="widx">
    <header class="widx__hero container-site">
      <span class="q-cut widx__cut" aria-hidden="true"></span>
      <h1 class="widx__title">Selected work.</h1>
      <p class="widx__lede">
        Seven projects across my own products, open-source tools, and the
        platforms I've worked on.
      </p>
    </header>

    <div class="widx__layout container-site">
      <section class="widx__group" aria-label="Case studies">
        <ol class="widx__list">
          {allProjects.map(p => (
            <li>
              <ProjectIndexRow
                href={`/work/${p.slug}`}
                name={p.data.title}
                index={numberOf(p.slug)}
                summary={p.data.short}
                category={p.data.category}
                thumbnail={thumbnail(p.slug)}
                meta={p.data.roleShort ?? p.data.role}
                status={p.data.inProgress ? 'In QA & field testing' : undefined}
                project={p.slug}
              />
            </li>
          ))}
        </ol>
      </section>

      <aside class="widx__preview" aria-hidden="true">
        {allProjects.map((p, i) => (
          <figure class:list={['widx__preview-item', { 'is-active': i === 0 }]} data-preview={p.slug}>
            <img class="widx__preview-img" src={thumbnail(p.slug)} alt="" width="480" height="300" loading="lazy" decoding="async" />
            <figcaption class="widx__preview-caption">
              <span class="widx__preview-name">{p.data.title}</span>
              <span class="widx__preview-meta">{p.data.category}{p.data.inProgress ? ' · In QA & field testing' : ''}</span>
              <span class="widx__preview-role">{p.data.roleShort ?? p.data.role}</span>
            </figcaption>
          </figure>
        ))}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  function initWorkPreview() {
    const layout = document.querySelector<HTMLElement>('.widx__layout');
    if (!layout || layout.dataset.previewBound === 'true') return;
    layout.dataset.previewBound = 'true';
    const items = [...layout.querySelectorAll<HTMLElement>('[data-preview]')];
    const rows = [...layout.querySelectorAll<HTMLElement>('[data-project]')];
    const activate = (slug: string) => {
      items.forEach(item => item.classList.toggle('is-active', item.dataset.preview === slug));
    };
    rows.forEach(row => {
      const slug = row.dataset.project;
      if (!slug) return;
      row.addEventListener('mouseenter', () => activate(slug));
      row.addEventListener('focus', () => activate(slug));
    });
  }
  initWorkPreview();
  document.addEventListener('astro:page-load', initWorkPreview);
</script>

<style>
  /* The index is the counterweight to the homepage: dense where the homepage
     is spacious, text-led where the homepage is posters. The list is the only
     object: hairline row rules, no cards, no radius, no shadow. */

  .widx {
    padding-top: calc(60px + var(--space-10));
    padding-bottom: var(--space-24);
  }

  @media (min-width: 768px) {
    .widx {
      padding-top: calc(64px + var(--space-16));
    }
  }

  .widx__hero {
    margin-bottom: var(--space-12);
  }

  .widx__cut {
    margin-bottom: var(--space-5);
  }

  .widx__title {
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 66px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    font-weight: 800;
    color: var(--color-text);
    max-width: 14ch;
  }

  .widx__lede {
    margin-top: var(--space-5);
    max-width: 58ch;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .widx__layout {
    display: grid;
    grid-template-columns: 1fr;
  }

  .widx__preview {
    display: none;
  }

  @media (min-width: 900px) {
    .widx__layout {
      grid-template-columns: minmax(0, 1fr) clamp(280px, 24vw, 340px);
      gap: clamp(var(--space-6), 4vw, var(--space-12));
      align-items: start;
    }

    .widx__preview {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }

    .widx__preview-item {
      display: none;
      margin: 0;
    }

    .widx__preview-item.is-active {
      display: block;
    }

    .widx__preview-img {
      display: block;
      width: 100%;
      height: auto;
      object-fit: contain;
      border: 1px solid var(--q-line);
      border-radius: 12px;
      background: var(--q-surface);
    }

    .widx__preview-caption {
      display: flex;
      flex-direction: column;
      gap: 6px;
      padding-top: var(--space-4);
    }

    .widx__preview-name {
      font-family: var(--font-display);
      font-size: clamp(24px, 2.2vw, 30px);
      font-weight: 800;
      letter-spacing: -.025em;
      line-height: 1.05;
      color: var(--color-text);
    }

    .widx__preview-meta {
      font-family: var(--font-mono);
      font-size: 10px;
      line-height: 1.5;
      color: var(--color-accent);
    }

    .widx__preview-role {
      font-family: var(--font-body);
      font-size: 12px;
      line-height: 1.55;
      color: var(--color-text-muted);
    }
  }

  .widx__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .widx__list > li:last-child :global(.q-index-row) {
    border-bottom: 1px solid var(--q-line);
  }
</style>
