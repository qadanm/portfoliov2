---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ProjectIndexRow from '@/components/ui/ProjectIndexRow.astro';

// Same ordering as the case-study template, so the index position a visitor
// reads here is the same "04 / 06" the case study shows.
const allProjects = (await getCollection('build', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const numberOf = (slug: string) =>
  String(allProjects.findIndex(p => p.slug === slug) + 1).padStart(2, '0');

const thumbnail = (slug: string) => `/images/work-thumbs/${slug}.webp`;
---

<BaseLayout
  title="Selected Work"
  description="Selected case studies by Moe Qadan. CarSpotter, a daily car-identification game for iPhone; VINly, free VIN research for used-car buyers; vinplain, an open-source TypeScript client for US vehicle records; ChatOBD2, an AI-native diagnostics product in QA; MagTek's multi-site platform; and advisor portals deployed across more than 50 wealth and banking institutions at InvestCloud."
  keywords={[
    'Moe Qadan',
    'portfolio',
    'UX engineering portfolio',
    'frontend portfolio',
    'design systems portfolio',
    'case studies',
    'CarSpotter',
    'VINly',
    'vinplain',
    'ChatOBD2',
    'MagTek',
    'InvestCloud',
  ]}
  image="/brand-system/open_graph/work_light.png"
  imageAlt="Selected work. / Moe Qadan"
>
  <div class="widx">
    <header class="widx__hero container-site">
      <span class="q-cut widx__cut" aria-hidden="true"></span>
      <h1 class="widx__title">Selected work.</h1>
      <p class="widx__lede">
        Seven projects across my own products, open-source tools, and the
        platforms I've worked on.
      </p>
    </header>

    <section class="widx__group container-site" aria-label="Case studies">
      <ol class="widx__list">
        {allProjects.map(p => (
          <li>
            <ProjectIndexRow
              href={`/work/${p.slug}`}
              name={p.data.title}
              index={numberOf(p.slug)}
              summary={p.data.short}
              category={p.data.category}
              thumbnail={thumbnail(p.slug)}
              meta={p.data.roleShort ?? p.data.role}
              status={p.data.inProgress ? 'In QA & field testing' : undefined}
              project={p.slug}
            />
          </li>
        ))}
      </ol>
    </section>
  </div>
</BaseLayout>

<style>
  /* The index is the counterweight to the homepage: dense where the homepage
     is spacious, text-led where the homepage is posters. The list is the only
     object: hairline row rules, no cards, no radius, no shadow. */

  .widx {
    padding-top: calc(60px + var(--space-10));
    padding-bottom: var(--space-24);
  }

  @media (min-width: 768px) {
    .widx {
      padding-top: calc(64px + var(--space-16));
    }
  }

  .widx__hero {
    margin-bottom: var(--space-12);
  }

  .widx__cut {
    margin-bottom: var(--space-5);
  }

  .widx__title {
    font-family: var(--font-display);
    font-size: clamp(38px, 6vw, 66px);
    line-height: 1.02;
    letter-spacing: -0.015em;
    font-weight: 800;
    color: var(--color-text);
    max-width: 14ch;
  }

  .widx__lede {
    margin-top: var(--space-5);
    max-width: 58ch;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .widx__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .widx__list > li:last-child :global(.q-index-row) {
    border-bottom: 1px solid var(--q-line);
  }
</style>
