---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import QadanSignature from '@/components/brand/QadanSignature.astro';
import { getCollection } from 'astro:content';

// The CarSpotter timeline entry reads the project record rather than keeping
// its own paragraph, so About cannot drift from the home card, the case study
// header or the metadata. Source of truth: src/content/build/car-spotter.mdx.
const carSpotter = (await getCollection('build')).find(p => p.slug === 'car-spotter');
const cs = carSpotter?.data;
const carSpotterAbout =
  cs?.secondaryCopy?.about ??
  'CarSpotter is my independent iPhone game, designed and engineered end to end.';
---

<BaseLayout
  title="About"
  description="Background and practice of Moe Qadan, a senior UX and frontend practitioner based in Los Angeles. UX engineering, design systems, frontend implementation, and AI-assisted product work across long-running platforms and independent product surfaces."
  keywords={[
    'Moe Qadan',
    'about',
    'UX engineer',
    'frontend engineer',
    'design engineer',
    'web experience',
    'design systems',
    'background',
    'creative technologist',
    'Los Angeles',
  ]}
  image="/brand-system/open_graph/about_light.png"
  imageAlt="Moe Qadan. / Moe Qadan"
>
  <div class="about">

    <header class="about__hero">
      <div class="container-site">
        <div class="about__hero-grid">
          <div class="about__hero-copy">
            <div class="about__sxn">
              <span class="q-cut" aria-hidden="true"></span>
              <span class="about__sxn-label">Profile</span>
              <span class="about__sxn-meta">Independent senior generalist</span>
            </div>

            <h1 class="about__title">
              <span class="vhidden">Moe Qadan.</span>
              <QadanSignature />
            </h1>
            <p class="about__hero-sub">
              Senior UX and frontend practitioner based in Los Angeles. I
              do the parts of web work that usually get split across a
              team. Most days that's the seam where Figma, the codebase,
              the content model, the SEO graph, and the performance budget
              all have to agree.
            </p>

            <div class="about__id-strip">
              <a href="/contact" class="about__id-status" aria-label="Send a message">
                <span class="about__id-status-dot" aria-hidden="true"></span>
                Send a message
              </a>
              <span class="about__id-sep" aria-hidden="true">/</span>
              <span class="about__id-loc">Los Angeles, CA</span>
              <span class="about__id-sep" aria-hidden="true">/</span>
              <a href="mailto:moe@qadan.co" class="about__id-mail">moe@qadan.co</a>
            </div>
          </div>

          <aside class="about__hero-portrait">
            <div class="about__portrait-frame">
              {/* Stage layers behind the figure: backlight + grounding plinth.
                  These keep the all-black wardrobe from sinking into the dark
                  background. */}
              <div class="about__portrait-stage" aria-hidden="true">
                <span class="about__portrait-glow"></span>
                <span class="about__portrait-plinth"></span>
              </div>

              <img
                src="/images/portrait/qadan-portrait.webp"
                alt="Portrait of Moe Qadan"
                width="1122"
                height="1402"
                fetchpriority="high"
                decoding="async"
                class="about__portrait-img"
              />

            </div>
          </aside>
        </div>
      </div>
    </header>

    <div class="container-site about__body">
      <div class="about__main">
        {/* What I'm best at */}
        <section class="about__section">
          <header class="about__sxn about__sxn--inner">
            <span class="about__sxn-label">What I'm best at</span>
          </header>
          <h2 class="about__h2">A few shapes the work tends to take.</h2>
          <ul class="about__bullets">
            <li><strong>Own the whole web surface.</strong> UX, design system, frontend, content model, SEO, performance and accessibility on one person. The current example is <a href="/work/magtek-platform">MagTek's multi-site platform</a>.</li>
            <li><strong>Modernize systems that can't be rewritten.</strong> Long-running stacks, live traffic, integrations the business depends on. The work is incremental and invisible when it lands. See <a href="/work/financial-platforms">Advisor Platforms</a>.</li>
            <li><strong>Build AI features as engineering.</strong> Prompts in source, schema-bound outputs, deterministic logic in front of the model. <a href="/work/vinly">VINly</a> reads and validates the VIN on the device with no model in the loop; <a href="/work/chatobd2">ChatOBD2</a> is in QA and field testing.</li>
          </ul>
        </section>

        {/* Background */}
        <section class="about__section">
          <header class="about__sxn about__sxn--inner">
            <h2 class="about__sxn-label">Background</h2>
            <span class="about__sxn-meta">2018 to present</span>
          </header>

          <ol class="about__career">
            <li class="about__career-item about__career-item--current about__career-item--flagship">
              <header class="about__career-head">
                <span class="about__career-status">
                  <span class="about__career-status-dot"></span>
                  Current
                </span>
                <h3 class="about__career-title">{cs?.title ?? 'CarSpotter'}</h3>
                <span class="about__career-period">{cs?.period ?? '2026–present'}</span>
              </header>
              <p class="about__career-desc">{carSpotterAbout}</p>
              <p class="about__career-links">
                <a href="https://apps.apple.com/app/carspotter-daily-car-game/id6777868215" target="_blank" rel="noopener" data-track="cta_click" data-track-cta="about-appstore" data-track-project="car-spotter">App Store ↗</a>
                <span aria-hidden="true">·</span>
                <a href="https://carspottergame.com" target="_blank" rel="noopener" data-track="cta_click" data-track-cta="about-site" data-track-project="car-spotter">carspottergame.com ↗</a>
              </p>
            </li>

            <li class="about__career-item about__career-item--current about__career-item--flagship">

              <header class="about__career-head">
                <span class="about__career-status">
                  <span class="about__career-status-dot"></span>
                  Current
                </span>
                <h3 class="about__career-title">VINly</h3>
                <span class="about__career-period">2026</span>
              </header>
              <p class="about__career-desc">
                Founder, sole designer and engineer. An iOS app that reads
                a VIN and hands back the car's public safety record for
                free: open recalls, owner complaints, crash tests, real
                fuel cost, and listings nearby. The hard part was trust.
                Every VIN is check-digit validated on the device before a
                lookup, and the photo never leaves the phone. Live on the
                App Store.
              </p>
              <p class="about__career-links">
                <a href="https://apps.apple.com/us/app/vinly-buyer-reports/id6774041303" target="_blank" rel="noopener" data-track="cta_click" data-track-cta="about-appstore" data-track-project="vinly">App Store ↗</a>
                <span aria-hidden="true">·</span>
                <a href="https://vinly.dev" target="_blank" rel="noopener" data-track="cta_click" data-track-cta="about-site" data-track-project="vinly">vinly.dev ↗</a>
              </p>
            </li>

            <li class="about__career-item about__career-item--current about__career-item--flagship">

              <header class="about__career-head">
                <span class="about__career-status">
                  <span class="about__career-status-dot"></span>
                  Current
                </span>
                <h3 class="about__career-title">ChatOBD2</h3>
                <span class="about__career-period">2025 to present</span>
              </header>
              <p class="about__career-desc">
                Founder, sole designer and engineer. AI-native automotive
                diagnostics product I built end to end: mobile app,
                marketing site, developer portal, prompt pipeline. The
                design problem was translation. Vehicle data is messy and
                technical; the verdict has to be a single sentence the
                driver can act on. Now in QA and field testing. Not yet publicly
                released.
              </p>
            </li>

            <li class="about__career-item about__career-item--current about__career-item--platform">

              <header class="about__career-head">
                <span class="about__career-status">
                  <span class="about__career-status-dot"></span>
                  Current
                </span>
                <h3 class="about__career-title">MagTek</h3>
                <span class="about__career-period">Now</span>
              </header>
              <p class="about__career-desc">
                I lead the web experience across MagTek.com, Magensa, the
                hardware product line, the support portal, and the network
                of related properties built on the shared ASP.NET MVC
                substrate. The work is platform-level: a 100+ component
                Razor partial library, a CSS foundation rebuilt as design
                tokens, navigation grammar that travels, sequenced
                migrations that don't break production.
              </p>
            </li>

            <li class="about__career-item about__career-item--product">

              <header class="about__career-head">
                <span class="about__career-status about__career-status--past">Past</span>
                <h3 class="about__career-title">InvestCloud</h3>
                <span class="about__career-period">Earlier</span>
              </header>
              <p class="about__career-desc">
                Contributed to or led 0-to-production deploys for advisor
                and customer portals across <strong>50+ wealth-management and
                banking institutions</strong>: Chase, Cetera, Northwestern
                Mutual, Voya, Silicon Valley Bank, East West Bank, and
                many more. Multi-tenant frontend, per-institution branding,
                dense data layouts, and the discipline that comes from
                fifty deploys against the same substrate.
              </p>
            </li>
          </ol>
        </section>

      </div>

      {/* Right column aside */}
      <aside class="about__aside">
        <div class="about__card about__card--current">

          <header class="about__card-head">
            <h3 class="about__card-title">Currently</h3>
          </header>

          <ul class="about__card-list">
            <li>
              <span class="about__card-key">Focus</span>
              <span class="about__card-val">UX + frontend as one job. Design systems. AI-native product work. Long-running platforms.</span>
            </li>
            <li>
              <span class="about__card-key">Building</span>
              <span class="about__card-val about__card-val--building">
                <a href="/work/car-spotter">CarSpotter</a>,
                <a href="/work/vinly">VINly</a>,
                <a href="/work/chatobd2">ChatOBD2</a>,
                <a href="/work/magtek-platform">MagTek</a>
              </span>
            </li>
            <li>
              <span class="about__card-key">Based in</span>
              <span class="about__card-val">Los Angeles, California</span>
            </li>
          </ul>
        </div>

        <div class="about__card about__card--reach">

          <header class="about__card-head">
            <h3 class="about__card-title">Reach out</h3>
          </header>
          <p class="about__card-note">
            Project questions, design or engineering conversations. Email works too.
          </p>
          <a href="/contact" class="about__card-cta">
            Get in touch
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    position: relative;
  }



  .about__hero {
    position: relative;
    padding-top: calc(60px + var(--space-10));
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .about__hero {
      padding-top: calc(64px + var(--space-16));
      padding-bottom: var(--space-12);
      margin-bottom: var(--space-12);
    }
  }

  /* Shared section-head pattern */
  .about__sxn {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .about__sxn--inner {
    margin-bottom: var(--space-5);
  }


  .about__sxn-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .about__sxn-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), transparent);
    min-width: 32px;
  }

  .about__sxn-meta {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  .about__title {
    font-family: var(--font-display);
    font-size: clamp(48px, 11vw, 96px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    color: var(--color-text);
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .about__hero-sub {
    font-size: clamp(16px, 1.7vw, 19px);
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 62ch;
    margin-bottom: var(--space-6);
  }

  /* Identity strip below the intro */
  .about__id-strip {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px 14px;
    font-size: 13px;
    line-height: 1.4;
    margin-top: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border-subtle);
  }

  .about__id-status {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 4px 11px 4px 10px;
    border-radius: 9999px;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text);
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color 150ms, border-color 150ms, color 150ms;
  }

  .about__id-status:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
    background-color: var(--color-accent-dim);
  }

  .about__id-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--color-text-subtle);
    transition: background-color 150ms;
  }

  .about__id-status:hover .about__id-status-dot {
    background-color: var(--color-accent);
  }

  .about__id-sep {
    color: var(--color-border-strong);
    font-family: var(--font-body);
    font-size: 11px;
  }

  .about__id-loc {
    color: var(--color-text-muted);
    font-family: var(--font-body);
    font-size: 12px;
  }

  .about__id-mail {
    color: var(--color-text);
    font-family: var(--font-body);
    font-size: 12px;
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: color 150ms, text-decoration-color 150ms;
  }

  .about__id-mail:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  /* Hero two-column: copy beside the portrait */
  .about__hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  .about__hero-copy {
    min-width: 0;
  }

  @media (min-width: 640px) {
    .about__hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(220px, 280px);
      gap: var(--space-8);
      align-items: center;
    }
  }

  @media (min-width: 880px) {
    .about__hero-grid {
      grid-template-columns: 1fr minmax(260px, 360px);
      gap: clamp(var(--space-8), 5vw, var(--space-16));
    }
  }

  /* Portrait — same designed-object fingerprint as the project cards:
     bordered frame, accent backlight, grounding plinth, corner crosshairs.
     The backlight + plinth + stacked drop-shadows are what stop the
     all-black wardrobe from disappearing into the dark background. */
  .about__hero-portrait {
    position: relative;
    width: 100%;
    max-width: 320px;
    margin-inline: auto;
  }

  @media (min-width: 640px) {
    .about__hero-portrait {
      max-width: 280px;
      margin-inline: 0;
      justify-self: end;
    }
  }

  @media (min-width: 880px) {
    .about__hero-portrait {
      max-width: 360px;
    }
  }

  .about__portrait-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 1122 / 1402;
    border-radius: var(--radius-2xl);
    border: 1px solid var(--color-border);
    overflow: hidden;
    isolation: isolate;
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.04) inset,
      0 30px 60px -20px rgba(0, 0, 0, 0.45);
    background:
      linear-gradient(180deg,
        color-mix(in srgb, var(--color-bg-elevated) 85%, transparent) 0%,
        color-mix(in srgb, var(--color-bg-muted) 95%, transparent) 60%,
        color-mix(in srgb, var(--color-bg-deep) 95%, transparent) 100%
      );
    transition: border-color 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }

  :global([data-theme="light"]) .about__portrait-frame {
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.6) inset,
      0 1px 2px rgba(15, 15, 20, 0.04),
      0 24px 48px -16px rgba(15, 15, 20, 0.10);
  }

  .about__portrait-frame:hover {
    border-color: var(--color-accent-muted);
  }

  .about__portrait-stage {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* Ambient backlight that catches the upper torso. */
  .about__portrait-glow {
    position: absolute;
    top: 12%;
    left: 50%;
    transform: translateX(-50%);
    width: 110%;
    height: 75%;
    background:
      radial-gradient(ellipse 50% 60% at 50% 40%,
        color-mix(in srgb, var(--color-accent) 18%, transparent) 0%,
        color-mix(in srgb, var(--color-accent) 6%, transparent) 35%,
        transparent 70%
      );
    filter: blur(28px);
    opacity: 0.85;
  }

  :global([data-theme="light"]) .about__portrait-glow {
    background:
      radial-gradient(ellipse 50% 60% at 50% 40%,
        color-mix(in srgb, var(--color-accent) 12%, transparent) 0%,
        color-mix(in srgb, var(--color-accent) 4%, transparent) 35%,
        transparent 70%
      );
    opacity: 0.7;
  }

  /* Tonal panel the lower torso lands on. */
  .about__portrait-plinth {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 32%;
    background:
      linear-gradient(180deg,
        transparent 0%,
        color-mix(in srgb, var(--color-bg-deep) 40%, transparent) 35%,
        color-mix(in srgb, var(--color-bg-deep) 80%, transparent) 100%
      );
  }

  :global([data-theme="light"]) .about__portrait-plinth {
    background:
      linear-gradient(180deg,
        transparent 0%,
        color-mix(in srgb, #1F1408 5%, transparent) 35%,
        color-mix(in srgb, #1F1408 9%, transparent) 100%
      );
  }

  .about__portrait-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
    z-index: 2;
    filter:
      contrast(1.03)
      saturate(1.05)
      drop-shadow(0 0 0.4px rgba(0, 0, 0, 0.95))
      drop-shadow(0 0 0.8px rgba(0, 0, 0, 0.75))
      drop-shadow(0 0 1.4px rgba(0, 0, 0, 0.45))
      drop-shadow(0 14px 30px rgba(0, 0, 0, 0.4));
    transition: transform 720ms var(--ease-out);
  }

  :global([data-theme="light"]) .about__portrait-img {
    filter:
      contrast(0.97)
      saturate(0.96)
      brightness(1.02)
      drop-shadow(0 0 0.4px rgba(40, 30, 20, 0.55))
      drop-shadow(0 0 0.9px rgba(40, 30, 20, 0.35))
      drop-shadow(0 12px 24px rgba(15, 15, 20, 0.18));
  }

  .about__portrait-frame:hover .about__portrait-img {
    transform: scale(1.015);
  }

  .about__portrait-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--color-text-subtle);
    pointer-events: none;
    z-index: 3;
    opacity: 0.55;
    transition: opacity 240ms, border-color 240ms;
  }

  .about__portrait-frame:hover .about__portrait-corner {
    opacity: 1;
    border-color: var(--color-accent);
  }

  .about__portrait-corner--tl { top: 10px; left: 10px; border-right: none; border-bottom: none; }
  .about__portrait-corner--tr { top: 10px; right: 10px; border-left: none; border-bottom: none; }
  .about__portrait-corner--bl { bottom: 10px; left: 10px; border-right: none; border-top: none; }
  .about__portrait-corner--br { bottom: 10px; right: 10px; border-left: none; border-top: none; }

  /* Body grid */
  .about__body {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-10);
    padding-bottom: var(--space-16);
  }

  @media (min-width: 768px) {
    .about__body {
      gap: var(--space-12);
      padding-bottom: var(--space-24);
    }
  }

  @media (min-width: 900px) {
    .about__body {
      grid-template-columns: 1fr 340px;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .about__main {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .about__main {
      gap: var(--space-16);
    }
  }

  .about__section {
    display: flex;
    flex-direction: column;
  }

  .about__h2 {
    font-family: var(--font-display);
    font-size: clamp(26px, 3vw, 36px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: var(--space-5);
    max-width: 28ch;
  }

  .about__para {
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.75;
    color: var(--color-text-muted);
    margin-bottom: var(--space-5);
    max-width: 60ch;
  }

  .about__para--note {
    font-size: 14px;
    color: var(--color-text-subtle);
    line-height: 1.65;
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-muted);
    max-width: 60ch;
    margin-top: var(--space-5);
  }

  .about__inline-link {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-color: var(--color-border);
    text-underline-offset: 3px;
    transition: color 150ms, text-decoration-color 150ms;
  }

  .about__inline-link:hover {
    color: var(--color-accent);
    text-decoration-color: var(--color-accent);
  }

  .about__bullets {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-6);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 64ch;
  }

  .about__bullets li {
    position: relative;
    padding-left: 24px;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.65;
    color: var(--color-text-muted);
  }

  .about__bullets li::before {
