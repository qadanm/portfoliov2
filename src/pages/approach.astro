---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import VerdictCardMock from '@/components/diagrams/VerdictCardMock.astro';
import AIFlow from '@/components/diagrams/AIFlow.astro';
import MethodSequence from '@/components/ui/MethodSequence.astro';
import { getCollection } from 'astro:content';
import { projectCategoryKey } from '@/lib/project';

// The CarSpotter example card reads the project record — image, alt and note —
// so the Approach page and the case study cannot tell different stories.
const carSpotter = (await getCollection('build')).find(p => p.slug === 'car-spotter');
const cs = carSpotter?.data;
// The grid wants the 1600px rung of the cover ladder, not the 2560 master.
const carSpotterCard = cs?.coverImage?.replace(/-\d+\.webp$/, '-1600.webp');

const projects = [
  {
    slug: 'vinly',
    title: 'VINly',
    note: "Scan a VIN, get the car's public safety record free. Designed and engineered solo for iOS.",
    src: '/images/vinly/site-hero.webp',
    alt: 'VINly marketing hero, "Scan any VIN. Know the car," beside the free research tool.',
    category: 'Independent product',
  },
  {
    slug: 'chatobd2',
    title: 'ChatOBD2',
    note: 'An AI car-diagnostics app, designed and built solo. In QA and field testing.',
    src: '/images/chatobd2/hero.webp',
    alt: 'ChatOBD2 marketing hero with phone mockup of a live diagnostic chat.',
    category: 'Independent product',
  },
  {
    slug: 'magtek-platform',
    title: 'MagTek',
    note: "I own the full stack across MagTek's eleven sites on ASP.NET MVC.",
    src: '/images/magtek/homepage.webp',
    alt: 'MagTek homepage with metric story and team photography.',
    category: 'Platform work',
  },
  {
    slug: 'car-spotter',
    title: cs?.title ?? 'CarSpotter',
    note: cs?.secondaryCopy?.approach ?? 'An independent iPhone game where I built the product, interface, game state, and content tooling.',
    src: carSpotterCard ?? '/images/car-spotter/2026-10/artwork/01-carspotter-portfolio-hero-1600.webp',
    alt: cs?.coverAlt ?? 'CarSpotter’s Saturn identity beside a genuine car-detail question and the matching reveal.',
    category: 'Independent product',
  },
  {
    slug: 'financial-platforms',
    title: 'Advisor portals',
    note: 'Multi-tenant frontend across 50+ wealth and banking institutions at InvestCloud.',
    src: '/images/financial-platforms/chase.webp',
    alt: 'Chase homepage built on the InvestCloud framework.',
    category: 'Platform work',
  },
];
---

<BaseLayout
  title="Approach"
  description="How Moe Qadan works: frontend, full-stack, design systems, content, performance, accessibility, and AI features."
  keywords={[
    'Moe Qadan',
    'design approach',
    'design engineering',
    'UX engineering',
    'frontend systems',
    'AI-assisted design',
    'prompt engineering',
    'design systems',
    'product design process',
  ]}
  image="/brand-system/open_graph/approach_light.png"
  imageAlt="How I work. / Moe Qadan"
>
  <div class="apr">

    <header class="apr__hero">
      <div class="container-site">
        <div class="apr__sxn">
          <span class="q-cut" aria-hidden="true"></span>
          <span class="apr__sxn-label">Approach</span>
        </div>
        <h1 class="apr__title">How I work.</h1>
        <p class="apr__subtitle">Frontend, full-stack, and AI features.</p>

      </div>
    </header>

    <div class="container-site apr__body">
      {/* Lead — discursive, not symmetrical */}
      <section class="apr__section apr__section--lead">
        <p class="apr__lead">
          Most of the work I take on is repair: a platform that grew
          without a system, a site that ranks but doesn't convert, a
          frontend that works in Chrome and breaks on iOS, or an AI
          feature that needs a real home in the codebase. Greenfield
          happens, but it's not most of my work.
        </p>

        <p class="apr__para">
          I work across the stack, mostly frontend: UX, design systems,
          content, SEO, performance, accessibility, and AI features. I can
          take a project from design through production and make the
          tradeoffs between those areas myself.
        </p>
      </section>

      {/* The method, with a real artifact per step */}
      <section class="apr__section apr__section--method">
        <header class="apr__sxn apr__sxn--inner">
          <span class="apr__sxn-label">Read / Pick / Use</span>
        </header>
        <h2 class="apr__h2">Three steps.</h2>
        <p class="apr__para">
          I start by reading the existing system, then choose a structure
          that fits it. I put the result in front of real users and review
          it before it ships.
        </p>
        <MethodSequence class="apr__method" headingLevel="h3" />
      </section>

      {/* What I actually do, day to day */}
      <section class="apr__section">
        <header class="apr__sxn apr__sxn--inner">
          <span class="apr__sxn-label">A normal week</span>
        </header>
        <h2 class="apr__h2">What a normal week looks like.</h2>

        <ul class="apr__bullets">
          <li>Change a Razor partial used in fifty places. The typed ViewModel shows every consumer that needs updating.</li>
          <li>Replace a carousel with a static hero, then move the pages and analytics one step at a time so nothing breaks.</li>
          <li>Find the spacing token that is almost right, then decide whether to add a new one or use the existing scale. Usually the existing scale.</li>
          <li>Write and version a prompt module for ChatOBD2, and keep it inside the 38,000-token budget.</li>
          <li>Translate a Figma handoff into production and fix small spacing issues as I go.</li>
          <li>Run Lighthouse after a marketing hero lands, find the LCP regression, and make a tradeoff both teams can live with.</li>
        </ul>
      </section>

      {/* AI in the work */}
      <section class="apr__section">
        <header class="apr__sxn apr__sxn--inner">
          <span class="apr__sxn-label">How I use AI</span>
        </header>
        <h2 class="apr__h2">In products and in the build.</h2>

        <p class="apr__para">
          I keep prompts in source, use them where they help, and review
          the output before it ships.
        </p>

        <div class="apr__flow">
          <AIFlow />
        </div>

        <p class="apr__para">
          <a href="/work/chatobd2">ChatOBD2</a> is the product example,
          currently in QA and field testing. Vehicle data goes through six
          deterministic reasoning layers before any model call. The system
          prompt is a module that assembles fragments by priority within a
          38,000-token budget, based on the verdict and code context. The
          fragments are typed, versioned, and reviewed in pull requests.
          Outputs are schema-bound, so the UI gets the shape it expects.
        </p>

        <p class="apr__para">
          <a href="/work/vinly">VINly</a> shows when to leave the model
          out. Its VIN reader used to send a photo to a server for a
          vision model. That worked, but it cost money on every scan of a
          free app, needed a network round trip, and forced a photo
          disclosure in App Privacy. Apple's Vision framework does the job
          on-device, offline, for free. I removed the model. A VIN is valid
          based on the ISO 3779 check digit, which the phone can calculate.
        </p>

        <p class="apr__para">
          I keep prompts in source, version them, test failure modes, and
          track token budgets like any other resource. New behavior lands
          as a new prompt fragment with a clear name.
        </p>

        <div class="apr__art">
          <span class="apr__art-caption">ChatOBD2 verdict surface</span>
          <VerdictCardMock />
        </div>

        <p class="apr__para">
          For code, I use Claude and Cursor; which one depends on the
          task. Figma is for design and component systems. Claude Design
          is for early visual exploration, and the result goes back into
          the codebase.
        </p>

        <p class="apr__para">
          The model is one step in a controlled pipeline. A person makes
          the final call.
        </p>
      </section>

      {/* What I bring */}
      <section class="apr__section">
        <header class="apr__sxn apr__sxn--inner">
          <span class="apr__sxn-label">What I do</span>
        </header>
        <h2 class="apr__h2">Where I do my best work.</h2>

        <ul class="apr__bullets">
          <li>I can own a whole site when there isn't a team for it: design, frontend, content, SEO, performance, and accessibility.</li>
          <li>I modernize platforms that can't be rewritten. I learn how the current system works, then ship changes in small steps that don't require a flag day.</li>
          <li>I build design systems engineers use: typed components, tokens, and layout primitives, with real consumers from the start.</li>
          <li>I work between design and engineering. I read the intent behind a design and catch the handoff gaps that cause bugs.</li>
          <li>I build AI features with prompts in source, schema-bound output, and deterministic checks before the model call. <a href="/work/vinly">VINly</a> validates the VIN on-device; <a href="/work/chatobd2">ChatOBD2</a> uses six reasoning layers and a 38,000-token budget.</li>
        </ul>
      </section>

      {/* Tools */}
      <section class="apr__section">
        <header class="apr__sxn apr__sxn--inner">
          <span class="apr__sxn-label">Tools</span>
        </header>
        <h2 class="apr__h2">What I use.</h2>

        <ul class="apr__tools">
          <li class="apr__tool">
            <header class="apr__tool-head">
              <span class="apr__tool-name">Claude</span>
            </header>
            <span class="apr__tool-role">For code changes and reasoning across multiple files.</span>
          </li>
          <li class="apr__tool">
            <header class="apr__tool-head">
              <span class="apr__tool-name">Cursor</span>
            </header>
            <span class="apr__tool-role">For local iteration. Same kind of work as Claude; whichever is faster.</span>
          </li>
          <li class="apr__tool">
            <header class="apr__tool-head">
              <span class="apr__tool-name">Figma</span>
            </header>
            <span class="apr__tool-role">For design and component systems.</span>
          </li>
          <li class="apr__tool">
            <header class="apr__tool-head">
              <span class="apr__tool-name">Claude Design</span>
            </header>
            <span class="apr__tool-role">For early visual exploration; the result goes back into code.</span>
          </li>
        </ul>
      </section>

      {/* Across the work */}
      <section class="apr__section">
        <header class="apr__sxn apr__sxn--inner">
          <span class="apr__sxn-label">Across the work</span>
        </header>
        <h2 class="apr__h2">Different companies, same question.</h2>
        <p class="apr__para">
          How do I move this page or platform forward without breaking
          what is already running?
        </p>

        <div class="apr__work-grid">
          {projects.map(p => (
            <a
              href={`/work/${p.slug}`}
              class:list={['apr__work', `apr__work--${projectCategoryKey(p.category)}`]}
            >

              <div class="apr__work-shot">
                <img
                  src={p.src}
                  alt={p.alt}
                  width="1440"
                  height="900"
                  loading="lazy"
                />
              </div>
              <div class="apr__work-meta">
                <div class="apr__work-copy">
                <span class="apr__work-cat">{p.category}</span>
                <h3 class="apr__work-title">{p.title}</h3>
                <p class="apr__work-note">{p.note}</p>
                <span class="apr__work-cta">
                  Case study
                  <svg width="12" height="12" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                    <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </section>

      {/* Closing CTA */}
      <section class="apr__cta">
        <span class="apr__cta-glow" aria-hidden="true"></span>

        <div class="apr__cta-text">
          <div class="apr__cta-eyebrow">
            <span class="apr__cta-dot"></span>
            <span>Get in touch</span>
          </div>
          <h2 class="apr__cta-title">Working on something on the web?</h2>
          <p class="apr__cta-sub">
            Send a few sentences. Email works too.
          </p>
        </div>
        <div class="apr__cta-actions">
          <a href="/contact" class="apr__cta-primary">
            Send a message
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="mailto:moe@qadan.co" class="apr__cta-ghost">moe@qadan.co</a>
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .apr {
    position: relative;
  }



  .apr__hero {
    position: relative;
    padding-top: calc(60px + var(--space-10));
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border-subtle);
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .apr__hero {
      padding-top: calc(64px + var(--space-16));
      padding-bottom: var(--space-12);
      margin-bottom: var(--space-12);
    }
  }

  /* Shared section-head pattern */
  .apr__sxn {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }

  .apr__sxn--inner {
    margin-bottom: var(--space-4);
  }


  .apr__sxn-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .apr__sxn-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), transparent);
    min-width: 32px;
  }

  .apr__sxn-meta {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  .apr__title {
    font-family: var(--font-display);
    font-size: clamp(40px, 9vw, 80px);
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.05;
    color: var(--color-text);
    max-width: 18ch;
    margin-bottom: var(--space-5);
  }

  .apr__subtitle {
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.6;
    color: var(--color-text-subtle);
    max-width: 60ch;
  }

  .apr__body {
    padding-bottom: var(--space-16);
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    max-width: 1080px;
  }

  @media (min-width: 768px) {
    .apr__body {
      padding-bottom: var(--space-24);
      gap: var(--space-16);
    }
  }

  .apr__section {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .apr__section--lead {
    gap: var(--space-6);
  }

  .apr__h2 {
    font-family: var(--font-display);
    font-size: clamp(26px, 3.2vw, 40px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.15;
    color: var(--color-text);
    margin-bottom: var(--space-3);
    max-width: 24ch;
  }

  .apr__lead {
    font-family: var(--font-display);
    font-size: clamp(20px, 2.4vw, 26px);
    font-weight: 400;
    letter-spacing: -0.015em;
    line-height: 1.4;
    color: var(--color-text);
    max-width: 60ch;
  }

  .apr__para {
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.75;
    color: var(--color-text-muted);
    max-width: 64ch;
  }

  .apr__para strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .apr__bullets {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    max-width: 66ch;
  }

  .apr__bullets li {
    position: relative;
    padding-left: 24px;
    font-size: clamp(15px, 1.5vw, 17px);
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .apr__bullets li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 12px;
    height: 1px;
    background-color: var(--color-accent);
  }

  .apr__bullets strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .apr__art {
    margin: var(--space-4) 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .apr__art-caption {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-subtle);
  }

  .apr__art :global(.verdict-mock__head) {
    display: none;
  }

  .apr__art :global(.verdict-mock) {
    margin: 0;
  }

  .apr__flow {
    margin: var(--space-2) 0 var(--space-4);
  }

  /* Tools cards */
  .apr__tools {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 640px) {
    .apr__tools {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-4);
    }
  }

  .apr__tool {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background:
      linear-gradient(180deg, var(--color-bg-elevated), var(--color-bg-muted));
    box-shadow: var(--shadow-card);
    overflow: hidden;
    transition: border-color 280ms, transform 280ms var(--ease-out), box-shadow 280ms;
  }

  .apr__tool:hover {
    border-color: var(--color-accent-muted);
    transform: translateY(-2px);
    box-shadow: var(--shadow-card-hover);
  }

  .apr__tool-corner {
    position: absolute;
    width: 8px;
    height: 8px;
    border: 1px solid var(--color-text-subtle);
    pointer-events: none;
    opacity: 0.4;
    transition: opacity 240ms, border-color 240ms;
  }

  .apr__tool-corner--tl { top: 8px; left: 8px; border-right: none; border-bottom: none; }
  .apr__tool-corner--br { bottom: 8px; right: 8px; border-left: none; border-top: none; }

  .apr__tool:hover .apr__tool-corner {
    opacity: 1;
    border-color: var(--color-accent);
  }

  .apr__tool-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }


  .apr__tool-name {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    color: var(--color-text);
    letter-spacing: -0.01em;
    line-height: 1;
  }

  .apr__tool-role {
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  /* Work grid — across-the-work */
  .apr__method {
    margin-top: var(--space-6);
  }

  .apr__work-cat {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 9px;
    font-weight: 500;
    letter-spacing: .04em;
    color: var(--color-accent);
    margin-bottom: 4px;
  }

  .apr__work-cat::before {
    content: '';
    width: 5px;
    height: 5px;
    background: var(--color-accent);
    clip-path: polygon(0 0, 4px 0, 5px 1px, 1px 1px);
  }

  .apr__work-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-3);
  }

  @media (min-width: 640px) {
    .apr__work-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }

  .apr__work {
    --pc-accent: var(--color-accent);
    position: relative;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-2xl);
    background:
      linear-gradient(180deg, var(--color-bg-elevated), var(--color-bg-muted));
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transition: border-color 320ms var(--ease-out), transform 320ms var(--ease-out), box-shadow 320ms var(--ease-out);
  }


  .apr__work:hover {
    border-color: var(--color-border-strong);
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
  }

  .apr__work-corner {
    position: absolute;
    width: 10px;
    height: 10px;
    border: 1px solid var(--color-text-subtle);
    pointer-events: none;
    opacity: 0.35;
    transition: opacity 240ms, border-color 240ms;
    z-index: 3;
  }

  .apr__work:hover .apr__work-corner {
    opacity: 1;
    border-color: var(--pc-accent);
  }

  .apr__work-corner--tl { top: 8px; left: 8px; border-right: none; border-bottom: none; }
  .apr__work-corner--tr { top: 8px; right: 8px; border-left: none; border-bottom: none; }
  .apr__work-corner--bl { bottom: 8px; left: 8px; border-right: none; border-top: none; }
  .apr__work-corner--br { bottom: 8px; right: 8px; border-left: none; border-top: none; }

  .apr__work-shot {
    overflow: hidden;
    border-bottom: 1px solid var(--color-border);
  }

  .apr__work-shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 700ms var(--ease-out);
  }

  .apr__work:hover .apr__work-shot img {
    transform: scale(1.025);
  }

  .apr__work-meta {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding: var(--space-5) var(--space-6) var(--space-6);
  }

  .apr__work-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .apr__work-scrim {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background: rgba(250, 250, 249, 0.90);
  }

  :global([data-theme="dark"]) .apr__work-scrim {
    background: rgba(12, 12, 14, 0.86);
  }

  .apr__work-title {
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0;
  }

  .apr__work-note {
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-text-muted);
    margin: 0;
  }

  .apr__work-cta {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: var(--space-2);
    padding-top: var(--space-3);
    border-top: 1px solid var(--color-border-subtle);
    font-family: var(--font-body);
    font-size: 11px;
