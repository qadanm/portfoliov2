---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import ContactForm from '@/components/ContactForm.astro';

const channels = [
  {
    label: 'Email',
    value: 'moe@qadan.co',
    href: 'mailto:moe@qadan.co',
    primary: true,
  },
  {
    label: 'LinkedIn',
    value: 'linkedin.com/in/mqadan',
    href: 'https://linkedin.com/in/mqadan',
    external: true,
  },
  {
    label: 'GitHub',
    value: 'github.com/qadanm',
    href: 'https://github.com/qadanm',
    external: true,
  },
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Moe Qadan. Project questions, design and engineering conversations, speaking and writing inquiries."
  keywords={[
    'contact Moe Qadan',
    'UX engineer Los Angeles',
    'frontend engineer Los Angeles',
    'design engineer',
    'creative technologist',
  ]}
  image="/brand-system/open_graph/contact_light.png"
  imageAlt="Tell me what you are working on. / Moe Qadan"
>
  <div class="contact">

    <div class="container-site contact__inner">
      <header class="contact__head">
        <div class="contact__sxn">
          <span class="q-cut" aria-hidden="true"></span>
          <span class="contact__sxn-label">Contact</span>
          <span class="contact__sxn-meta">Los Angeles, CA</span>
        </div>

        <h1 class="contact__title">
          Tell me what you're working on.
        </h1>

        <p class="contact__lede">
          For project questions and design or engineering conversations.
          Use the form or email me directly.
        </p>
      </header>

      <div class="contact__grid">
        {/* Form card */}
        <section class="contact__form-card" aria-labelledby="contact-form-heading">
          <header class="contact__form-head">
            <h2 id="contact-form-heading" class="contact__form-title">Send a message</h2>
          </header>

          <div class="contact__form-wrap">
            <ContactForm variant="full" formId="contact-form-full" />
          </div>
        </section>

        {/* Direct channels */}
        <aside class="contact__channels-wrap" aria-labelledby="contact-channels-heading">
          <header class="contact__channels-head">
            <h2 id="contact-channels-heading" class="contact__channels-title">Or reach me directly</h2>
          </header>

          <ul class="contact__channels">
            {channels.map(c => (
              <li>
                <a
                  href={c.href}
                  class:list={['contact__channel', { 'contact__channel--primary': c.primary }]}
                  target={c.external ? '_blank' : undefined}
                  rel={c.external ? 'noopener noreferrer' : undefined}
                  data-track="contact_click"
                  data-track-channel={c.label.toLowerCase()}
                  data-track-loc="contact-page"
                >

                  <span class="contact__channel-label">{c.label}</span>
                  <span class="contact__channel-value">{c.value}</span>
                  <span class="contact__channel-icon" aria-hidden="true">
                    {c.external ? (
                      <svg width="14" height="14" viewBox="0 0 14 14" fill="none">
                        <path d="M5 2h7v7M12 2 2 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    ) : (
                      <svg width="14" height="14" viewBox="0 0 16 16" fill="none">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                      </svg>
                    )}
                  </span>
                </a>
              </li>
            ))}
          </ul>

          <footer class="contact__foot">
            <p class="contact__foot-text">
              Based in Los Angeles. Working PT/CST/EST hours, but flexible.
            </p>
          </footer>
        </aside>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .contact {
    position: relative;
    padding-top: calc(60px + var(--space-10));
    padding-bottom: var(--space-16);
    min-height: 80vh;
  }

  @media (min-width: 768px) {
    .contact {
      padding-top: calc(64px + var(--space-16));
      padding-bottom: var(--space-24);
    }
  }



  .contact__inner {
    position: relative;
  }

  /* Numbered head */
  .contact__head {
    max-width: 760px;
    margin-bottom: var(--space-10);
  }

  @media (min-width: 768px) {
    .contact__head {
      margin-bottom: var(--space-12);
    }
  }

  .contact__sxn {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-5);
    flex-wrap: wrap;
  }


  .contact__sxn-label {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 600;
    color: var(--color-text);
  }

  .contact__sxn-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), transparent);
    min-width: 32px;
  }

  .contact__sxn-meta {
    margin-left: auto;
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-text-subtle);
    white-space: nowrap;
  }

  .contact__title {
    font-family: var(--font-display);
    font-size: clamp(34px, 7vw, 60px);
    font-weight: 800;
    letter-spacing: -0.022em;
    line-height: 1.05;
    color: var(--color-text);
    margin-bottom: var(--space-5);
    max-width: 18ch;
  }

  @media (min-width: 768px) {
    .contact__title { margin-bottom: var(--space-6); }
  }

  .contact__lede {
    font-size: clamp(16px, 1.6vw, 18px);
    line-height: 1.65;
    color: var(--color-text-muted);
    max-width: 60ch;
  }

  /* Two-column body */
  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .contact__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: var(--space-10);
      align-items: start;
    }
  }

  /* ─── Form card ───────────────────────────────────────────────────── */
  .contact__form-card {
    position: relative;
    padding: var(--space-6) 0 0;
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 600px) {
    .contact__form-card {
      padding: var(--space-7) var(--space-8);
    }
  }

  @media (min-width: 1024px) {
    .contact__form-card {
      padding: var(--space-8) var(--space-9);
    }
  }


  .contact__form-corner {
    position: absolute;
    width: 12px;
    height: 12px;
    border: 1px solid var(--color-text-subtle);
    pointer-events: none;
    opacity: 0.5;
    z-index: 2;
  }

  .contact__form-corner--tl { top: 12px; left: 12px; border-right: none; border-bottom: none; }
  .contact__form-corner--tr { top: 12px; right: 12px; border-left: none; border-bottom: none; }
  .contact__form-corner--bl { bottom: 12px; left: 12px; border-right: none; border-top: none; }
  .contact__form-corner--br { bottom: 12px; right: 12px; border-left: none; border-top: none; }

  .contact__form-head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-6);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-subtle);
    z-index: 1;
  }


  .contact__form-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .contact__form-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), transparent);
  }

  .contact__form-wrap {
    position: relative;
    z-index: 1;
  }

  /* Style overrides on the form for the new submit treatment */



  /* ─── Channels ────────────────────────────────────────────────────── */
  .contact__channels-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  @media (min-width: 900px) {
    .contact__channels-wrap {
      position: sticky;
      top: 84px;
    }
  }

  .contact__channels-head {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: var(--space-1);
  }


  .contact__channels-title {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .contact__channels-rule {
    flex: 1;
    height: 1px;
    background: linear-gradient(to right, var(--color-border), transparent);
  }

  .contact__channels {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .contact__channel {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    min-height: 56px;
    border-top: 1px solid var(--color-border);
    background: none;
    text-decoration: none;
    color: var(--color-text);
    -webkit-tap-highlight-color: transparent;
  }

  .contact__channel:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  .contact__channel--primary .contact__channel-value {
    color: var(--color-accent);
  }

  .contact__channel:hover .contact__channel-value {
    color: var(--color-accent);
  }




  .contact__channel-label {
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-text-subtle);
    width: 80px;
    flex-shrink: 0;
  }

  .contact__channel--primary .contact__channel-label {
    color: var(--color-accent);
  }

  .contact__channel-value {
    flex: 1;
    font-size: 15px;
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.005em;
    word-break: break-all;
  }

  .contact__channel-icon {
    color: var(--color-text-subtle);
    transition: color 200ms, transform 200ms;
    flex-shrink: 0;
    display: inline-flex;
  }

  .contact__channel:hover .contact__channel-icon {
    color: var(--pc-accent);
    transform: translate(2px, -2px);
  }

  @media (max-width: 560px) {
    .contact__channel {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas:
        "label icon"
        "value icon";
      align-items: center;
      column-gap: var(--space-3);
      row-gap: 4px;
    }

    .contact__channel-label {
      grid-area: label;
      width: auto;
    }

    .contact__channel-value {
      grid-area: value;
      font-size: 16px;
    }

    .contact__channel-icon {
      grid-area: icon;
    }
  }

  /* Footer line */
  .contact__foot {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    padding-top: var(--space-3);
  }


  .contact__foot-text {
    font-family: var(--font-body);
    font-size: 11px;
    color: var(--color-text-subtle);
    line-height: 1.55;
    margin: 0;
  }
</style>
