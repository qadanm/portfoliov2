---
import '../styles/global.css';
const { title = 'Qadan Tools', description = 'Private tools for repeatable work.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="qadan-build-version" content="__BUILD_VERSION__" />
    <meta name="theme-color" content="#151714" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/tools-180.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Qadan Tools" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="identity" href="/" aria-label="Qadan Tools home"><span class="identity-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>Qadan <em>Tools</em></span></a>
        <a class="portfolio-link" href="https://qadan.co/" target="_blank" rel="noopener noreferrer">Portfolio <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" /></svg></a>
      </header>
      <main><slot /></main>
      <footer class="site-footer"><span>Qadan Tools</span><span>Built for the work I do often.</span></footer>
    </div>
    <script is:inline type="module" src="/update-home.js?v=3"></script>
  </body>
</html>
