# The custom domain is gated by Cloudflare Access. The Pages Worker redirects
# pages.dev hostnames to that domain before static content is served. The Worker
# controls cache headers for code and manifests; avoid disabling caching for
# every photo, font, and flag here.
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: interest-cohort=()
  X-Robots-Tag: noindex, nofollow
